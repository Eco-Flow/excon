// Nextflow config applied to all benchmark runs.
// Uses timestamped filenames for trace/report/timeline so that each run
// (including resumes) gets its own file — matching Nextflow's default behaviour
// for pipeline_dag. collect_metrics.py picks up the latest trace per run.
//
// Nextflow 26's config parser forbids top-level variable declarations (a shared
// `def ts = ...` here previously), so the timestamp is inlined at each of the
// three points it's needed instead. Each block evaluates its own `new Date()`
// a few milliseconds apart from the others — irrelevant here, since all three
// only need to be unique per run, not identical to each other.

trace {
    file      = "output/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.tsv"
    overwrite = true
}
report {
    file      = "output/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = true
}
timeline {
    file      = "output/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = true
}
