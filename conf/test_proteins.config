/*
 * -profile test_proteins: -profile test with half the species given as
 * proteomes (--input_proteins) rather than genomes and annotations, so one run
 * covers both kinds of input and their joining (tests/proteins.nf.test).
 * The same 10 Chlamydia species: 5 genomes + annotations
 * (data/input_test_proteins_genomes.csv) and NCBI's RefSeq proteomes of the
 * other 5 (data/input_test_proteins.csv), fetched straight from NCBI's FTP site.
 * Everything else, including the NCBI download limits, comes from -profile test.
 */
includeConfig 'test.config'

params {
  input          = "${projectDir}/data/input_test_proteins_genomes.csv"
  input_proteins = "${projectDir}/data/input_test_proteins.csv"
}
