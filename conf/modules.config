/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'GFFREAD' {
        ext.args = '-y'
        publishDir = [
            path: { "${params.outdir}/gffread" },
            mode: params.publish_dir_mode
        ]
    }

    // The proteomes behind every gene ID in Orthogroups.tsv. Published so a completed
    // run can be reused later via --orthofinder_results/--proteome_dir.
    withName: 'RENAME_FASTA' {
        publishDir = [
            path: { "${params.outdir}/proteomes" },
            mode: params.publish_dir_mode
        ]
    }

    // v2 runs search, orthogroup inference and phylogeny in one process, so unlike the
    // split v3 path it takes -S here as well as -M/-A/-T.
    withName: 'ORTHOFINDER_V2_CAFE' {
        ext.args = {
            def args = []
            if (params.orthofinder_method)   args << "-M ${params.orthofinder_method}"
            if (params.orthofinder_msa_prog) args << "-A ${params.orthofinder_msa_prog}"
            if (params.orthofinder_tree)     args << "-T ${params.orthofinder_tree}"
            if (params.orthofinder_search)   args << "-S ${params.orthofinder_search}"
            return args.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/orthofinder_cafe" },
            mode: params.publish_dir_mode
        ]
    }

    // Stage 1: reciprocal DIAMOND blast — CPU-heavy, can be parallelised
    // Resources come from process_high (8 CPUs, 12 GB) + process_med_long (24h) labels
    withName: 'ORTHOFINDER_BLAST_CAFE' {
        ext.args = {
            def args = []
            if (params.orthofinder_search) args << "-S ${params.orthofinder_search}"
            return args.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/orthofinder_blast" },
            mode: params.publish_dir_mode
        ]
    }

    // Stage 2: orthogroup inference + phylogeny. -t controls tree inference
    // parallelism (as well as DIAMOND), so uses the same process_high CPU count
    // as blast. -a (internal algorithm steps) is capped at 4 in the script.
    withName: 'ORTHOFINDER_PHYLO_CAFE' {
        memory = { 24.GB * task.attempt }
        ext.args = {
            def args = []
            if (params.orthofinder_method)   args << "-M ${params.orthofinder_method}"
            if (params.orthofinder_msa_prog) args << "-A ${params.orthofinder_msa_prog}"
            if (params.orthofinder_tree)     args << "-T ${params.orthofinder_tree}"
            return args.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/orthofinder_cafe" },
            mode: params.publish_dir_mode
        ]
    }

    // IQ-TREE2 species tree from the concatenated single-copy orthogroup alignment.
    // The partition file is passed as -spp (edge-proportional partition model, the -p
    // alias), -m MFP selects a model per partition, and -B/--alrt give ultrafast
    // bootstrap and SH-aLRT support.
    withName: 'ALIGN_SINGLE_COPY' {
        ext.args = '--auto'
    }

    withName: 'CONCAT_SINGLE_COPY' {
        publishDir = [
            path: { "${params.outdir}/species_tree/supermatrix" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'IQTREE_SPECIES_TREE' {
        cpus       = { 8     * task.attempt }
        memory     = { 16.GB * task.attempt }
        time       = { 24.h  * task.attempt }
        ext.prefix = 'species_tree'
        // --quiet keeps the console readable: ModelFinder emits a "Normalizing state
        // frequencies" line every time it instantiates an empirical amino-acid matrix,
        // which is tens of thousands of lines across hundreds of partitions. The full
        // log is still written to species_tree.log and published.
        ext.args   = {
            def extra = params.iqtree_args ?: ''
            // A model fixed in the partition file, or named in --iqtree_args, must not be
            // overridden by the default -m MFP — IQ-TREE rejects a second -m alongside a
            // partition file. '-mset'/'-mem' are different options and do not count.
            def part_model = params.iqtree_partition_model ?: 'AA'
            def has_model  = extra.startsWith('-m ') || extra.contains(' -m ') || part_model != 'AA' || params.iqtree_partition_file
            def model      = has_model ? '' : '-m MFP '
            return "${model}-B 1000 --alrt 1000 --quiet${extra ? ' ' + extra : ''}"
        }
        publishDir = [
            path: { "${params.outdir}/species_tree/iqtree" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ROOT_TREE' {
        publishDir = [
            path: { "${params.outdir}/species_tree" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'DATE_TREE' {
        publishDir = [
            path: { "${params.outdir}/species_tree" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PRUNE_TREE' {
        publishDir = [
            path: { "${params.outdir}/species_tree" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_RUN' {
        ext.args = { meta.id == 'gamma'            ? '-k 3'    :
                     meta.id == 'gamma_per_family' ? '-p -k 3' : '' }
        publishDir = [
            path: { "${params.outdir}/cafe/${meta.id}" },
            mode: params.publish_dir_mode
        ] 

    }

    withName: 'CAFE_PREP' {
        memory = { 24.GB * task.attempt }
        publishDir = [
            path: { "${params.outdir}/cafe/base" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_SELECT_K' {
        publishDir = [
            path: { "${params.outdir}/cafe/model_comparison" },
            pattern: "*.{tsv,txt}",
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_MODEL_COMPARE' {
        publishDir = [
            [
                path: { "${params.outdir}/cafe/model_comparison" },
                pattern: "*.{tsv,txt}",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe/best" },
                pattern: "best_cafe_results",
                mode: params.publish_dir_mode,
                saveAs: { "." }
            ]
        ]
    }

    withName: 'CAFE_RUN_LARGE' {
        // Each family now runs on its own (a single row of data), so this no
        // longer needs the memory the old shared-batch run required — the
        // process_single label's defaults are plenty.
        publishDir = [
            path: { "${params.outdir}/cafe/large_families/per_family" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MERGE_CAFE_LARGE_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/cafe/large_families" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_GO_PREP' {
        publishDir = [
            [
                path: { "${params.outdir}/cafe_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}" },
                pattern: "CAFE_summary.txt",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}/go_inputs" },
                pattern: "*.pos.txt",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}/go_inputs" },
                pattern: "*.neg.txt",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}/go_inputs" },
                pattern: "*.BK.txt.uniq",
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'CAFE_GO_RUN' {
        publishDir = [
            path: { "${params.outdir}/cafe_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHROMO_GO' {
        publishDir = [
            path: { "${params.outdir}/chromo_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_PLOT' {
        publishDir = [
            path: { "${params.outdir}/cafe_plot" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_NODE_GUIDE' {
        publishDir = [
            path: { "${params.outdir}/cafe_plot" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_SIG_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/cafe/significant_families" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_SIG_FAMILIES_LARGE' {
        publishDir = [
            path: { "${params.outdir}/cafe/significant_families_large" },
            mode: params.publish_dir_mode
        ]
    }

    // The combined main+large report is the headline output of the two tracks
    // above, so it is published alongside the main model's own significant-
    // families tables rather than off in its own directory.
    withName: 'COMBINE_CAFE_SIG_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/cafe/significant_families" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_PLOT_ALTVIZ' {
        publishDir = [
            path: { "${params.outdir}/cafe_plot" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_PLOT_LARGE' {
        publishDir = [
            path: { "${params.outdir}/cafe_plot_large" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_GO_PREP_LARGE' {
        publishDir = [
            path: { "${params.outdir}/cafe_go_large/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAFE_GO_RUN_LARGE' {
        publishDir = [
            path: { "${params.outdir}/cafe_go_large/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BUSCO_BUSCO' {
        publishDir = [
            path: { "${params.outdir}/busco" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'AGAT_SPKEEPLONGESTISOFORM' {
        publishDir = [
            path: { "${params.outdir}/agat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'AGAT_SPSTATISTICS' {
        publishDir = [
            path: { "${params.outdir}/agat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NCBIGENOMEDOWNLOAD' {
        ext.args          = "--formats fasta,gff -N"
        errorStrategy     = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries        = 2
        maxForks          = params.ncbi_max_forks
        publishDir = [
            path: { "${params.outdir}/ncbigenomedownload" },
            mode: params.publish_dir_mode
        ]
    }

withName: 'EGGNOGMAPPER' {
    publishDir = [
        path: { "${params.outdir}/eggnogmapper" },
        mode: params.publish_dir_mode
    ]
    ext.args = {
        def args = []

        if (params.eggnog_target_taxa)
            args << "--target_taxa '${params.eggnog_target_taxa}'"

        if (params.eggnog_tax_scope)
            args << "--tax_scope '${params.eggnog_tax_scope}'"

        if (params.eggnog_evalue)
            args << "--evalue ${params.eggnog_evalue}"

        if (params.eggnog_score)
            args << "--score ${params.eggnog_score}"

        if (params.eggnog_pident)
            args << "--pident ${params.eggnog_pident}"

        if (params.eggnog_query_cover)
            args << "--query_cover ${params.eggnog_query_cover}"

        if (params.eggnog_subject_cover)
            args << "--subject_cover ${params.eggnog_subject_cover}"

        return args.join(' ')
    }
}
    
    withName: 'EGGNOG_TO_GO' {
        publishDir = [
            path: { "${params.outdir}/eggnogmapper/go_files" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'OG_ANNOTATION_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/eggnogmapper" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUMMARIZE_CAFE_GO' {
        publishDir = [
            path: { "${params.outdir}/cafe_go_summary/cafe_go/raw_plotting_files" },
            pattern: "*.tsv",
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUMMARIZE_CAFE_GO_LARGE' {
        publishDir = [
            path: { "${params.outdir}/cafe_go_summary/cafe_go_large/raw_plotting_files" },
            pattern: "*.tsv",
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLOT_CAFE_GO' {
        publishDir = [
            [
                path: { "${params.outdir}/cafe_go_summary/cafe_go" },
                pattern: "*.{pdf,png,svg,tsv}",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe_go_summary/cafe_go/raw_plotting_files" },
                pattern: "*.R",
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'PLOT_CAFE_GO_LARGE' {
        publishDir = [
            [
                path: { "${params.outdir}/cafe_go_summary/cafe_go_large" },
                pattern: "*.{pdf,png,svg,tsv}",
                mode: params.publish_dir_mode
            ],
            [
                path: { "${params.outdir}/cafe_go_summary/cafe_go_large/raw_plotting_files" },
                pattern: "*.R",
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'SUMMARIZE_CHROMO_GO' {
        publishDir = [
            path: { "${params.outdir}/chromo_go/${params.go_algo}_cutoff${params.go_cutoff}_type${params.go_type}/summary" },
            mode: params.publish_dir_mode
        ]
    }
}
