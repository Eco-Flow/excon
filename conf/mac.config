// Local Mac profile. Combine with a container profile, e.g. -profile test_chlamydia,docker,mac

// Drops the -u flag so amd64 containers work under Rosetta on Docker 29+
docker.runOptions = ''

params {
    // Each genome download parses the whole NCBI assembly summary for its taxonomic
    // group. Running many at once starves an emulated laptop CPU, so a few at a time
    // is faster overall. The pipeline default stays high for cluster runs.
    ncbi_max_forks = 3
}
