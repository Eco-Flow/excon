/*
 * -profile test: a quick end-to-end run of the whole pipeline, used by CI
 * (tests/default.nf.test). The 10 Chlamydia species of test_chlamydia, close
 * enough for CAFE5 to fit, with genomes and annotations fetched straight from
 * NCBI's FTP site over HTTPS (data/input_test.csv). That skips
 * ncbi-genome-download, which first fetches NCBI's 245 MB index of every
 * bacterial assembly; test_chlamydia still runs that step, from accessions.
 *
 * CAFE5's k-sweep is the slowest part: on a 4-CPU runner its fits run one
 * after another, and the k = 4-6 gamma fits take longest, so only k = 1-3.
 */
params {
  input                      = "${projectDir}/data/input_test.csv"
  cafe_max_k                 = 3
  max_memory                 = '14.GB'
  max_cpus                   =  4
  max_time                   = '6.h'
  iqtree_args                = '-mset LG,WAG,JTT'
}

// NCBI's FTP server answers HTTP 503 when too many files are fetched at once.
// Nextflow stages remote files on its FileTransfer thread pool (10+ threads by
// default); two at a time, with more retries, keeps within NCBI's limits.
// (filePorter.maxTransfers alone only applies with Java virtual threads.)
threadPool.FileTransfer.minThreads = 2
threadPool.FileTransfer.maxThreads = 2
filePorter.maxTransfers            = 2
filePorter.maxRetries              = 6
