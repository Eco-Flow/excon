params {
  input                      = "${projectDir}/data/input_chlamydia.csv"
  // Restrict the NCBI lookup to bacteria; the default 'all' makes every download
  // task fetch the assembly summary for every taxonomic group.
  groups                     = 'bacteria'
  // Max resources for test input data can be reduced
  max_memory                 = '24.GB'
  max_cpus                   =  10
  max_time                   = '24.h'
  // Restrict ModelFinder to three common amino-acid matrices. Full per-partition
  // model selection over hundreds of partitions dominates the runtime of this
  // profile, and the point here is to exercise the steps, not to publish the tree.
  iqtree_args                = '-mset LG,WAG,JTT'
}
