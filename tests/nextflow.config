// Extra config applied on top of the chosen profile for every nf-test run.

// One image cache for every test. Each nf-test test runs in its own launch
// directory, and the singularity/apptainer profiles set a cacheDir relative to
// it, so without this every test pulls the same images again. CI sets
// NXF_SINGULARITY_CACHEDIR; without it, the profiles' own defaults are kept.
// (Nextflow 26's config syntax has no if statements, hence the ?: )
singularity.cacheDir = env('NXF_SINGULARITY_CACHEDIR') ?: 'singularity/cachedir'
apptainer.cacheDir   = env('NXF_SINGULARITY_CACHEDIR') ?: 'apptainer/cachedir'

// GitHub-hosted runners have 4 CPUs and 16 GB. Steps labelled process_high ask
// for more (CAFE_PREP: 8 CPUs), and Nextflow refuses a task that needs more than
// the machine has, so cap every test at the runner's size.
process {
    resourceLimits = [ cpus: 4, memory: 14.GB, time: 6.h ]
}
