// The search program (-S) for ORTHOFINDER_BLAST comes from the test's meta.search.
// In the pipeline it is --orthofinder_search, set for ORTHOFINDER_BLAST_CAFE in
// conf/modules.config.
process {
    withName: 'ORTHOFINDER_BLAST' {
        ext.args = { meta.search ? "-S ${meta.search}" : '' }
    }
}
