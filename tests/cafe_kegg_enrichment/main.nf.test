nextflow_process {

    name "CAFE_KEGG_ENRICHMENT"
    script "../../modules/local/cafe_kegg_enrichment.nf"
    process "CAFE_KEGG_ENRICHMENT"
    tag "cafe_kegg_enrichment"

    // data/: 20 modelled families over SpA and SpB (OG20 has no SpB gene).
    // KEGG pathways, from SpA's eggNOG annotations: map00010 in OG01-05, map00020 in
    // OG06-15 and OG20; OG16-19 have none. Significant: SpA expansions OG01-03 and OG06;
    // node 3 expansions OG01-02; SpB contraction OG06.
    // Expected p-values are R's phyper(k - 1, K, N - K, n, lower.tail = FALSE).

    test("Hypergeometric p-values and BH per node, against each node's background") {
        when {
            params { cafe_kegg_pathway_names = "${baseDir}/tests/cafe_kegg_enrichment/data/pathway_names.tsv" }
            process {
                """
                input[0] = files("${baseDir}/tests/cafe_kegg_enrichment/data/*.emapper.annotations")
                input[1] = file("${baseDir}/tests/cafe_kegg_enrichment/data/N0.tsv")
                input[2] = file("${baseDir}/tests/cafe_kegg_enrichment/data/Out_cafe")
                input[3] = file("${baseDir}/tests/cafe_kegg_enrichment/data/significant_changes_per_node.tsv")
                input[4] = file("${baseDir}/tests/cafe_kegg_enrichment/data/pathway_names.tsv")
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.table[0]).readLines()*.split('\t')
            def h = rows[0] as List
            def get = { node, pw -> rows.find { it[0] == node && it[2] == pw } }
            // SpA: 16 annotated families containing SpA, 5 with map00010, 3 of 4 foreground
            def a = get('SpA', 'map00010')
            assert a[h.indexOf('pathway_name')] == 'Glycolysis / Gluconeogenesis'
            assert a[h.indexOf('bg_annotated')] == '16' && a[h.indexOf('fg_annotated')] == '4'
            assert (a[h.indexOf('pvalue')] as double) == 0.0632            // phyper(2, 5, 11, 4)
            assert (a[h.indexOf('padj_BH')] as double) == 0.126            // 2 pathways tested
            // Internal node 3: every modelled family is background
            assert (get('3', 'map00010')[h.indexOf('pvalue')] as double) == 0.0833   // phyper(1, 5, 11, 2)
            // SpB: OG20 (no SpB gene) is not in its background: 15 annotated, 10 with map00020
            def b = get('SpB', 'map00020')
            assert b[h.indexOf('bg_annotated')] == '15' && b[h.indexOf('bg_with_pathway')] == '10'
            assert (b[h.indexOf('pvalue')] as double) == 0.667              // phyper(0, 10, 5, 1)
            assert path(process.out.significant[0]).readLines().size() == 1  // header only
        }
    }
}
