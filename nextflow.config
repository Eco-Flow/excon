manifest {
    name            = 'Eco-Flow/excon'
    author          = 'Chris Wyatt'
    homePage        = 'https://github.com/Eco-Flow/excon'
    description     = 'A pipeline to measure gene family expansion and contraction'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.6'
    version         = '2.4.0'
}

// Defaults parameters, expecting to be overwritten
params {
  // Core
  outdir                     = "results"
  // Path to input CSV (required unless --input_tree + --input_orthogroups are set and --run_eggnog/--stats are not)
  input                      = null
  // GO enrichment options (apply whichever GO annotation source is used)
  chromo_go                  = null
  go_cutoff                  = 0.05
  go_type                    = "none"
  go_max_plot                = 10
  go_algo                    = "classic_fisher"
  // Limit parallel jobs (useful on small clusters)
  forks                      = null  
  // Remove work directories upon pipeline completion
  clean                      = false
  // Path to a custom Nextflow config file
  custom_config              = null
  // Set by institutional configs (see --custom_config)
  config_profile_description = null
  config_profile_contact     = null
  config_profile_url         = null
  // Max resource options
  max_memory                 = '128.GB'
  max_cpus                   =  16
  max_time                   = '48.h'
  trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
  // Display help message with nf-validation
  help                       = null
  // nf-core module parameters
  publish_dir_mode           = 'copy'
  // NCBI taxonomic groups to download
  groups                     = 'all'
  // Genome downloads to run concurrently (lower on a laptop, see -profile mac)
  ncbi_max_forks             = 10
  // Run stats (QUAST+BUSCO+AGAT)
  stats                      = null
  // BUSCO options
  busco_mode                 = 'proteins'
  busco_lineage              = 'auto'
  busco_lineages_path        = null
  busco_config               = null

  // How RENAME_FASTA handles a premature (internal) stop codon in a translated CDS —
  // a common sign of a bad gene model (assembly or annotation error, or two species
  // annotated by different pipelines). 'longest_orf' (default since v2.5.0) keeps only
  // the single longest stretch between stops (same reading frame as annotated): a
  // real, if truncated, fragment, rather than 'strip's splice of two unrelated
  // flanking fragments into one fake sequence, or 'drop's outright loss of the gene.
  // 'strip' (v2.3.2–v2.4.0's default) removes every '*', including internal ones,
  // splicing the flanking peptide fragments into one sequence: keeps every gene, but
  // that spliced sequence is not a real protein. 'drop' discards the whole gene
  // instead — what OrthoFinder's own documentation recommends — at the cost of
  // losing it, and that species' count for its family, entirely. Either way, affected
  // genes are listed per species in <species>.internal_stop_codons.tsv (with
  // original/kept length) so the choice can be audited.
  internal_stop_action       = 'longest_orf'  // 'strip', 'drop' or 'longest_orf'

  // Pre-computed OrthoFinder inputs (skip the slow OrthoFinder step)
  input_tree                 = null  // path to SpeciesTree_rooted_node_labels.txt (or equivalent rooted Newick tree)
  input_orthogroups          = null  // path to Orthogroups.tsv from a previous OrthoFinder run

  // Path to a pre-computed blast WorkingDirectory from a previous ORTHOFINDER_BLAST run.
  // Skips the DIAMOND search step and jumps straight to orthogroup inference + phylogeny.
  // Useful for resuming a failed phylogeny stage or testing different tree methods.
  orthofinder_blast_results  = null

  // Reuse a completed OrthoFinder run instead of running it again. Needs the results
  // directory (for Orthogroups.tsv) and the proteomes those gene IDs refer to.
  orthofinder_results        = null
  proteome_dir               = null

  // OrthoFinder version — set to true to use v2.5.5 instead of v3.1.3.
  // v2.5.5 is recommended for large datasets where v3 runs fail or stall.
  orthofinder_v2             = false

  // OrthoFinder algorithm options (null = use OrthoFinder defaults)
  orthofinder_method         = null  // -M: gene tree inference method: 'msa' (default) or 'dendroblast'
  orthofinder_msa_prog       = null  // -A: MSA program (requires -M msa): 'mafft' (default) or 'muscle'
  orthofinder_search         = null  // -S: sequence search program: 'diamond' (default), 'blast', 'mmseqs2'
  orthofinder_tree           = null  // -T: tree inference method (requires -M msa): 'fasttree' (default), 'raxml', 'raxml-ng', 'iqtree'

  // IQ-TREE2 species tree from a concatenated single-copy orthogroup alignment,
  // used instead of the OrthoFinder tree. Works with any --orthofinder_method.
  iqtree_species_tree        = false
  iqtree_outgroup            = null  // comma-separated tip name(s) to root on; midpoint-rooted if null
  iqtree_args                = null  // extra IQ-TREE args, appended to the defaults
  iqtree_partition_model     = null  // model field per partition; 'AA' (default) lets ModelFinder choose
  iqtree_partition_file      = null  // reuse an existing partition file (e.g. a previous run's *.best_scheme)

  // Time-calibrate the species tree with ape::chronos before CAFE5, using node ages
  // from a TSV of clade/tips/age_min/age_max. Applies to whichever tree is in use
  // (OrthoFinder's or --iqtree_species_tree). CAFE5's lambda is then per Myr.
  tree_calibrations          = null
  chronos_model              = 'discrete'  // 'discrete', 'correlated' or 'relaxed'
  chronos_lambda             = 1           // rate smoothing
  chronos_rate_categories    = 10          // used by the 'discrete' model

  // Restrict the CAFE analysis to a subset of species. The tree is pruned and
  // cafe_prep.R subsets the gene-count table to match, so the same OrthoFinder run
  // can be analysed clade by clade. Give one or the other, not both.
  cafe_clade                 = null  // two+ tip names; their MRCA's clade is kept
  cafe_species               = null  // explicit tip names (comma-separated, or a file)

  // Branch-length scaling factor applied to the OrthoFinder species tree before CAFE5.
  // rescale_tree.py multiplies all branch lengths by this value; chronoMPL() in cafe_prep.R
  // then converts the result to an ultrametric tree. The default of 1000 works well in
  // most cases — lower values can cause numerical issues in CAFE5.
  // IGNORED when --input_tree_is_dated is set (the supplied tree is used unchanged).
  tree_scale_factor          = 1000

  // Treat --input_tree as an already time-calibrated, ultrametric tree (branch lengths in
  // millions of years). When true, the tree is passed to every CAFE5 stage UNCHANGED:
  //   * RESCALE_TREE is skipped (no branch-length multiplication),
  //   * chronoMPL() is skipped in cafe_prep.R (no re-derivation of branch lengths),
  //   * effectively --tree_scale_factor 1.
  // cafe_prep.R validates that the tree is rooted, binary, ultrametric, has positive
  // branch lengths, and that its leaf set matches the (subset) gene-count columns.
  input_tree_is_dated        = false

  // Pass CAFE5's -z / --zero_root option to every CAFE5 call (base, error-model, k-sweep,
  // best-model and large-family runs). Retains families inferred to have zero copies at the
  // analysis root (relevant to lineage-specific families such as odorant/gustatory receptors).
  // CAFE5 does not generally recommend this; use as a sensitivity analysis alongside the
  // default (cafe_zero_root=false) run.
  cafe_zero_root             = false

  // CAFE differential filtering threshold (used on retry after failure)
  // Lower values = more aggressive filtering; recommended: 20 (Vizueta et al. 2025),
  // 40 (conservative), 50 (balanced), 60 (lenient)
  skip_cafe                  = null
  cafe_max_differential      = 50
  // Apply that threshold from the first CAFE_PREP attempt rather than only on retries
  cafe_filter_first          = false
  cafe_max_k                 = 6

  // --- Retention of significantly changed families of interest ---
  // Optional OrthoFinder v2 output directories used to copy out the multiple-sequence
  // alignments and gene trees of HOGs that are significantly expanded at the internal
  // node(s) of interest (e.g. Vespinae, Vespinae+Polistinae). Leave null to skip.
  orthofinder_msa_dir        = null   // OrthoFinder MultipleSequenceAlignments/ (per-OG *.fa)
  orthofinder_genetree_dir   = null   // OrthoFinder Resolved_Gene_Trees/ (per-OG *_tree.txt)
  // Comma-separated CAFE internal node label(s) of interest (read off cafe_node_label_guide.pdf),
  // OR one or more '|'-separated tip-species sets whose MRCA defines a node (robust to the fact
  // that CAFE renumbers nodes per run). Example by MRCA:
  //   --cafe_focus_clades "Vespula_vulgaris,Vespa_crabro|Polistes_dominula,Vespula_vulgaris"
  cafe_focus_clades          = null

  // GO annotation — choose one of the two options below:

  // Option A: run EggNOG-mapper to assign GO terms from scratch
  //   The database is ~45 GB; provide --eggnog_data_dir to avoid re-downloading it every run.
  run_eggnog           = false
  eggnog_data_dir      = null   // path to pre-downloaded EggNOG data directory; downloaded automatically if null
  eggnog_target_taxa   = null   // restrict annotations to orthologs from this NCBI taxon ID and its descendants
  eggnog_tax_scope     = null   // taxonomic scope for OG assignment (e.g. 50557 for Insecta)
  eggnog_evalue        = null   // maximum e-value threshold for sequence matches
  eggnog_score         = null   // minimum bitscore
  eggnog_pident        = null   // minimum percent identity (%)
  eggnog_query_cover   = null   // minimum query coverage (%)
  eggnog_subject_cover = null   // minimum subject coverage (%)

  // Representative species for OG functional annotation summary.
  // Auto-selects the species with the most annotated genes when null.
  eggnog_rep_species = null

  // Option B: supply your own pre-computed gene-to-GO mapping files (skips EggNOG entirely)
  //   Point to a directory containing one file per species named {species_id}.go.txt.
  //   Each file must be a two-column TSV: gene_id<TAB>GO:term, one pair per line.
  predownloaded_gofiles = null
}

plugins {
  id 'nf-schema@2.5.1'
  id 'nf-amazon@2.5.2'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load custom config if provided
includeConfig params.custom_config ?: '/dev/null'

// Select a combination of useful profiles i.e. nextflow run -profile local,docker 
profiles {
  local {
    executor.name            = 'local'
  }
  aws_batch {
    includeConfig 'conf/aws_batch.config'
  }
  //Use Docker as the container management software
  docker {
    docker.enabled           = true
    // Remove docker containers after pipeline completes
    docker.remove            = true
    // Sets user for docker to the user who executes pipeline
    docker.runOptions        = '-u $(id -u):$(id -g)'
    // set registry to quay.io
    docker.registry          = "quay.io"
    // Ensure other container engines are unset
    singularity.enabled      = false
    apptainer.enabled        = false
  }
  singularity {
    singularity.enabled      = true
    // Set where singularity cached images are saved
    singularity.cacheDir     = "singularity/cachedir"
    // set registry to quay.io
    singularity.registry     = "quay.io"
    // Ensure other container engines are unset
    docker.enabled           = false
    apptainer.enabled        = false
  }
  apptainer {
    apptainer.enabled        = true
    // Set where singularity cached images are saved
    apptainer.cacheDir       = "apptainer/cachedir"
    // set registry to quay.io
    apptainer.registry       = "quay.io"
    // Ensure other container engines are unset
    docker.enabled           = false
    singularity.enabled      = false
  }
  conda {
    conda.enabled           = true
    docker.enabled          = false
    singularity.enabled     = false
    podman.enabled          = false
    shifter.enabled         = false
    charliecloud.enabled    = false
    conda.channels          = ['conda-forge', 'bioconda']
    apptainer.enabled       = false
}
  test_small { includeConfig 'conf/test_small.config' }
  test_bacteria { includeConfig 'conf/test_bacteria.config' }
  test_chlamydia { includeConfig 'conf/test_chlamydia.config' }
  test_bacteria_postortho { includeConfig 'conf/test_bacteria_postortho.config' }
  test_gffmix { includeConfig 'conf/test_gffmix.config' }
  test_primate { includeConfig 'conf/test_primate.config' }
  codespace { includeConfig 'conf/codespace.config' }
  mac { includeConfig 'conf/mac.config' }

}

// Load nf-core modules config
includeConfig 'conf/modules.config'

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capturing Nextflow log files into a rsults/pipeline_info directory
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

// Ensures work directories and removed when pipeline completes
cleanup = params.clean

// Cap process requests at the max_* params, and limit parallel jobs if --forks given
process {
    maxForks = params.forks
    resourceLimits = [
        cpus:   params.max_cpus   as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time   as nextflow.util.Duration
    ]
}

// Overide config if its supplied with --custom_config:
includeConfig params.custom_config ?: '/dev/null'
