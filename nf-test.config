config {
    // location for all nf-test tests
    testsDir = "."

    // nf-test directory including temporary files for each test
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile = "tests/nextflow.config"

    // ignore vendored nf-core module/subworkflow tests — not this pipeline's to maintain
    ignore = [
        'modules/nf-core/**/tests/*',
    ]

    // run all tests with a test profile small enough for CI + a container engine.
    // Not test_bacteria: its 4 species are too divergent for CAFE5 to fit any
    // model (k=1..6 all fail), exhausting retries every run regardless of
    // whether the pipeline itself is broken — see CHANGELOG's test_chlamydia
    // entry. test_chlamydia's species are close enough for CAFE to converge.
    profile = "test_chlamydia,docker"

    // list of filenames or patterns that should trigger a full test run
    triggers = [
        '.github/workflows/test-pipeline.yml',
        'conf/test_chlamydia.config',
        'data/input_chlamydia.csv',
        'main.nf',
        'nextflow.config',
        'nextflow_schema.json',
        'nf-test.config',
        'tests/.nftignore',
        'tests/nextflow.config',
    ]

    // provides getAllFilesFromDir(), used to build the structure/content snapshots
    plugins {
        load "nft-utils@0.0.3"
    }
}
